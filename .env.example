# App Settings
# Generate secret key: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
PORT=1963
API_PORT=1963
DBHOST=db
NAMEDB=aodproject
USERDB=aoduser
PASSDB=your_db_password_here

# Cache
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# External API Keys
# Get your key from: https://www.visualcrossing.com/weather-api
API_KEY=your_visual_crossing_api_key_here

# JAXA Himawari FTP credentials 
# Apply for credentials at: https://www.eorc.jaxa.jp/ptree/registration_top.html
USERHIMAWARI=your_jaxa_username
PASSHIMAWARI=your_jaxa_password