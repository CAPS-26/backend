# App Settings
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-hex-string
PORT=1963
API_PORT=1963
DBHOST=db

# Database (change for production)
NAMEDB=caps_jakarta
USERDB=caps_admin
PASSDB=change-this-password

# Cache
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# Timezone
SCHEDULER_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# Visual Crossing Weather API: https://www.visualcrossing.com/weather-api
API_KEY=your-visual-crossing-api-key

# JAXA Himawari FTP: https://www.eorc.jaxa.jp/ptree/registration_top.html
USERHIMAWARI=your-jaxa-ftp-username
PASSHIMAWARI=your-jaxa-ftp-password
